package httpapi

import "net/http"

// NewRouter wires inbound HTTP adapters. Inject feature services here as they
// are added; construct concrete repositories and services in cmd/api/main.go.
func NewRouter() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /health", func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		_, _ = w.Write([]byte("{\"status\":\"ok\"}\n"))
	})
	return mux
}
